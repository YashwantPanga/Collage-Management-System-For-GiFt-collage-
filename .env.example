# Copy to .env and adjust. Never commit the real .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# Database: sqlite (default) or postgres
DB_ENGINE=sqlite
DB_NAME=college_cms
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Email (leave EMAIL_HOST empty to print emails to the console)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=GIFT Autonomous <noreply@gift.edu.in>

# Razorpay payment gateway (leave empty to use the built-in test-mode gateway)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# College rules
ATTENDANCE_THRESHOLD=75
QR_ATTENDANCE_MINUTES=10
